{
  "name": "taller-6-clean-architecture",
  "version": "1.0.0",
  "description": "Taller 6 - Clean Architecture monorepo (Angular + NodeJS + Spring Boot)",
  "private": true,
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "concurrently --names \"NODE,ANGULAR\" \"npm:install:node\" \"npm:install:angular\"",
    "install:node": "npm --prefix Uceva-NodeJS-Taller-Clean-Architecture install",
    "install:angular": "npm --prefix Uceva-Angular-Taller-Clean-Architecture install",
    "start": "concurrently --kill-others --names \"NODE,SPRING,ANGULAR\" \"npm:start:node\" \"npm:start:spring\" \"npm:start:angular\"",
    "start:node": "npm --prefix Uceva-NodeJS-Taller-Clean-Architecture run start",
    "start:spring": "cd Uceva-SpringBoot-Taller-Clean-Architecture && gradlew.bat bootRun",
    "start:angular": "wait-on --timeout 300000 http://localhost:3000/api/docs http://localhost:8080/api/swagger-ui/index.html && npm --prefix Uceva-Angular-Taller-Clean-Architecture run start",
    "test": "concurrently --names \"NODE,SPRING,ANGULAR\" \"npm:test:node\" \"npm:test:spring\" \"npm:test:angular\"",
    "test:node": "npm --prefix Uceva-NodeJS-Taller-Clean-Architecture run test",
    "test:spring": "cd Uceva-SpringBoot-Taller-Clean-Architecture && gradlew.bat test",
    "test:angular": "npm --prefix Uceva-Angular-Taller-Clean-Architecture run test:coverage",
    "compodoc": "concurrently --names \"ANGULAR\" \"npm:compodoc:angular\"",
    "compodoc:angular": "npm --prefix Uceva-Angular-Taller-Clean-Architecture run compodoc",
    "build": "concurrently --names \"NODE,SPRING,ANGULAR\" \"npm:build:node\" \"npm:build:spring\" \"npm:build:angular\"",
    "build:node": "npm --prefix Uceva-NodeJS-Taller-Clean-Architecture run build",
    "build:spring": "cd Uceva-SpringBoot-Taller-Clean-Architecture && gradlew.bat build",
    "build:angular": "npm --prefix Uceva-Angular-Taller-Clean-Architecture run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "wait-on": "^8.0.5"
  }
}
